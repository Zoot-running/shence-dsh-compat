{
  "name": "@shence/dsh-compat",
  "version": "0.1.0",
  "description": "DSH compat —— OpenAI 兼容协议适配器插件(多路由): 国产模型(Kimi/智谱等)接入 DeepSeek Harness 的桥; 余额枯竭检测+隔离(F35)驻于此。集思的依赖项, 与集思本体无关。",
  "type": "module",
  "main": "lib/index.js",
  "types": "src/index.ts",
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --packages=external --outfile=lib/index.js",
    "test": "vitest run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "eventsource-parser": "^3.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-brand": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "vitest": "^2.1.0"
  }
}